# Backend Configuration for Render
# Copy this file to .env and fill in your actual values

# MongoDB Connection
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority&ssl=true
DATABASE_NAME=royal_amount_collector

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS Origins - Add your Vercel frontend URL
# Example: https://your-app.vercel.app,http://localhost:5173
BACKEND_CORS_ORIGINS=https://your-frontend-url.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Render External URL (automatically set by Render, but you can override)
# RENDER_EXTERNAL_URL=https://your-backend.onrender.com
